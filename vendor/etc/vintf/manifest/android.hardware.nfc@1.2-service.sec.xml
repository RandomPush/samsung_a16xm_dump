<manifest version="1.0" type="device">
<!-- NFC -->
  <hal format="hidl" override="true">
      <name>android.hardware.nfc</name>
      <transport>hwbinder</transport>
      <version>1.2</version>
      <interface>
          <name>INfc</name>
          <instance>default</instance>
      </interface>
  </hal>
  <hal format="hidl" override="true">
      <name>vendor.samsung.hardware.nfc</name>
      <transport>hwbinder</transport>
      <version>2.0</version>
      <interface>
          <name>ISehNfc</name>
          <instance>default</instance>
      </interface>
  </hal>
</manifest>
